echo "Killing stale ssh-agents..."
pkill ssh-agent

SSH_ENV="$HOME/.ssh/agent-environment"

function start_agent {
    echo "Initialising new SSH agent..."
    ssh-agent -T | sed 's/^echo/#echo/' > "${SSH_ENV}"
    echo succeeded
    chmod 600 "${SSH_ENV}"
    . "${SSH_ENV}" > /dev/null
	echo "GitHub"
    ssh-add $HOME/.ssh/id_ed25519_github;
	echo ""
    echo "Hetzner hosts"
	ssh-add $HOME/.ssh/id_ecdsa-hetzner
	echo ""
	echo "beastie.sdf.org"
	ssh-add $HOME/.ssh/id_ed25519_sdf
}

# Source SSH settings, if applicable

if [ -f "${SSH_ENV}" ]; then
    . "${SSH_ENV}" > /dev/null
    ps -ef | grep ${SSH_AGENT_PID} | grep ssh-agent$ > /dev/null || {
        start_agent;
    }
else
    start_agent;
fi
